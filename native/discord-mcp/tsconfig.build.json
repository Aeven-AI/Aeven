{
  // Compiles the Aeven-owned server under `aeven/` into `dist/`. The connector
  // spawns `dist/main.js` as a separate process, and Node cannot strip types
  // under `node_modules`, so the entry has to be real JavaScript on disk.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": "dist",
    "rootDir": "aeven"
  },
  "include": ["aeven/**/*.ts"]
}
