{
  "manifest_version": 3,
  "name": "Aeven",
  "description": "Let Aeven work in your browser: it drives its own tabs in an Aeven tab group and, with your OK, searches history and bookmarks.",
  "version": "0.3.37",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Aeven",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "history",
    "bookmarks",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "externally_connectable": {
    "matches": [
      "https://aeven.io/*",
      "https://*.aeven.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
