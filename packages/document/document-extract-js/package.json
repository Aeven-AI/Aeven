{
  "name": "@aeven/document-extract-js",
  "description": "Built-in document readers for PDF, Office, OpenDocument, Pages, Keynote, Numbers, RTF, EPUB, HTML, and text, run in worker threads",
  "version": "0.3.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/document/document-extract-js"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.cjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "unpdf": "^1.8.1"
  },
  "peerDependencies": {
    "@aeven/document-extract": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/document-extract": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "tsx": "^4.19.2",
    "xlsx": "file:./vendor/xlsx-0.20.3.tgz"
  }
}
