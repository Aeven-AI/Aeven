{
  "name": "@aeven/document-extract-ocr",
  "description": "OCR reader for scanned PDFs: pages rendered and recognized with Tesseract in a worker thread, language data bundled",
  "version": "0.3.1-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Harness.git",
    "directory": "packages/document/document-extract-ocr"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.cjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "@napi-rs/canvas": "^1.0.9",
    "@tesseract.js-data/eng": "^1.0.0",
    "pdfjs-dist": "6.1.200",
    "tesseract.js": "^7.0.0"
  },
  "peerDependencies": {
    "@aeven/document-extract": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/document-extract": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "tsx": "^4.19.2"
  }
}
