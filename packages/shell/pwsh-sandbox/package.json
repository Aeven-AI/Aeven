{
  "name": "@aeven/pwsh-sandbox",
  "description": "Sandbox-consuming implementation of the Aeven PowerShell executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.3.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/shell/pwsh-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/shell": "workspace:^",
    "@aeven/pwsh-local": "workspace:^",
    "@aeven/sandbox": "workspace:^",
    "@aeven/sandbox-policy": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/shell": "workspace:^",
    "@aeven/pwsh-local": "workspace:^",
    "@aeven/sandbox": "workspace:^",
    "@aeven/sandbox-local": "workspace:^",
    "@aeven/sandbox-policy": "workspace:^",
    "@aeven/session-projection": "workspace:^",
    "@aeven/subprocess-local": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
