{
  "name": "@aeven/speech-to-text-whisper",
  "description": "Local Whisper transcription with a managed whisper.cpp worker and on-demand verified models",
  "version": "0.3.11-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/speech/speech-to-text-whisper"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "runtime/assets.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@aeven/timeout": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@aeven/whisper-cpp-darwin-arm64": "workspace:^",
    "@aeven/whisper-cpp-darwin-x64": "workspace:^",
    "@aeven/whisper-cpp-linux-arm64": "workspace:^",
    "@aeven/whisper-cpp-linux-x64": "workspace:^",
    "@aeven/whisper-cpp-win32-arm64": "workspace:^",
    "@aeven/whisper-cpp-win32-x64": "workspace:^"
  },
  "peerDependencies": {
    "@aeven/speech-to-text": "workspace:^",
    "@aeven/subprocess": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/speech-to-text": "workspace:^",
    "@aeven/subprocess": "workspace:^",
    "@aeven/subprocess-local": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
