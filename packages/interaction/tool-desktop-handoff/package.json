{
  "name": "@aeven/tool-desktop-handoff",
  "description": "Model-facing offer_desktop tool that opens the Available in Aeven Desktop dialog in the window showing a session",
  "version": "0.3.44-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/interaction/tool-desktop-handoff"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/scope": "workspace:^",
    "@aeven/timeout": "workspace:^",
    "@aeven/tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/scope": "workspace:^",
    "@aeven/system-prompt": "workspace:^",
    "@aeven/timeout": "workspace:^",
    "@aeven/tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
