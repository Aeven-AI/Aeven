{
  "name": "@aeven/web-fetch-http",
  "description": "Anonymous public HTTP(S) fetch provider for the Aeven web capability seam (ctx.web)",
  "version": "0.3.10-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/web/web-fetch-http"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
