  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "ipaddr.js": "^2.5.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/timeout": "workspace:^",
    "@aeven/web": "workspace:^",
    "@aeven/http-proxy": "workspace:^"
  }
