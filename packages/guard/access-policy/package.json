{
  "name": "@aeven/tool-call-access-policy",
  "description": "Tool-call access policy: denies the tools whose effects bypass the filesystem sandbox while the session's access mode forbids them",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Harness.git",
    "directory": "packages/guard/access-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/sandbox": "workspace:^",
    "@aeven/sandbox-policy": "workspace:^",
    "@aeven/tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@aeven/llm": "workspace:^",
    "@aeven/sandbox": "workspace:^",
    "@aeven/sandbox-policy": "workspace:^",
    "@aeven/system-prompt": "workspace:^",
    "@aeven/tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  }
}
