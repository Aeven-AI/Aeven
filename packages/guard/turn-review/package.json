{
  "name": "@aeven/turn-review",
  "description": "Turn-review guard plugin: before a file-changing turn closes, a review call checks the reply against the turn's requests and tool results",
  "version": "0.3.20-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/guard/turn-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/timeout": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/timeout": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
