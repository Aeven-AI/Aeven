{
  "name": "@aeven/host-account-data",
  "description": "The signed-in account's data rights on a Host: a streamed zip export of everything the account keeps here and on the Aeven API, and erasing the account's local data once the API has purged it",
  "version": "0.3.61-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/host/account-data"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@aeven/home-paths": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "yazl": "3.3.1"
  },
  "peerDependencies": {
    "@aeven/attachment": "workspace:^",
    "@aeven/client-connection": "workspace:^",
    "@aeven/credentials": "workspace:^",
    "@aeven/memory": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-persistence": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@aeven/attachment": {
      "optional": true
    },
    "@aeven/memory": {
      "optional": true
    },
    "@aeven/session-persistence": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aeven/attachment": "workspace:^",
    "@aeven/client-connection": "workspace:^",
    "@aeven/credentials": "workspace:^",
    "@aeven/home-paths": "workspace:^",
    "@aeven/memory": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-persistence": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@types/yazl": "3.3.1"
  }
}
