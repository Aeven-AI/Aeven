{
  "name": "@aeven/host-workspace-files",
  "description": "Authenticated read-only HTTP route serving a registered workspace's files, so agent-produced files can be referenced from rendered model replies",
  "version": "0.3.3-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/host/workspace-files"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/host-webserver": "workspace:^",
    "@aeven/client-connection": "workspace:^",
    "@aeven/workspace": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@aeven/client-connection": "workspace:^",
    "@aeven/credentials-local": "workspace:^",
    "@aeven/host-frontend-static": "workspace:^",
    "@aeven/host-webserver": "workspace:^",
    "@aeven/workspace": "workspace:^"
  }
}
