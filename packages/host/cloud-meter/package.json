{
  "name": "@aeven/cloud-meter",
  "description": "Meters an account's Aeven Cloud work on a hosted Host and stops new cloud work once its credit is spent",
  "version": "0.3.43-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/host/cloud-meter"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/credentials": "workspace:^",
    "@aeven/llm-aeven": "workspace:^",
    "@aeven/sandbox-jail": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@aeven/sandbox-jail": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/credentials": "workspace:^",
    "@aeven/llm-aeven": "workspace:^",
    "@aeven/sandbox-jail": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
