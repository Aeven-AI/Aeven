{
  "name": "@aeven/client-ui-workspace-name",
  "description": "Workspace naming surface: the workspace directory-flow occupant that creates a Workspace with no directory under a title the reader types",
  "version": "0.3.43-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/client/ui-workspace-name"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "avn": {
    "client": {
      "inject": [
        "@aeven/client-ui-renderer",
        "@aeven/client-ui-workspace",
        "@aeven/client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/client-locale": "workspace:^",
    "@aeven/client-ui-primitives": "workspace:^",
    "@aeven/client-ui-renderer": "workspace:^",
    "@aeven/client-ui-slots": "workspace:^",
    "@aeven/client-ui-workspace": "workspace:^",
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
