{
  "name": "@aeven/client-ui-imagine",
  "description": "Imagine: a sidebar row that starts a chat with starter image prompts under its composer, the in-chat generated-image view, and the /image-model picker",
  "version": "0.3.16-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/client/ui-imagine"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "avn": {
    "client": {
      "inject": [
        "@aeven/api-remotes",
        "@aeven/api-session-controller",
        "@aeven/client-locale",
        "@aeven/client-ui-commands",
        "@aeven/client-ui-sidebar",
        "@aeven/client-ui-workspace",
        "@aeven/client-ui-renderer",
        "@aeven/client-ui-settings",
        "@aeven/client-ui-chat",
        "@aeven/client-ui-conversation",
        "@aeven/client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/api-remotes": "workspace:^",
    "@aeven/api-session-controller": "workspace:^",
    "@aeven/client-locale": "workspace:^",
    "@aeven/client-test-runtime": "workspace:^",
    "@aeven/client-ui-chat": "workspace:^",
    "@aeven/client-ui-commands": "workspace:^",
    "@aeven/client-ui-conversation": "workspace:^",
    "@aeven/client-ui-input-trigger": "workspace:^",
    "@aeven/client-ui-layout": "workspace:^",
    "@aeven/client-ui-primitives": "workspace:^",
    "@aeven/client-ui-renderer": "workspace:^",
    "@aeven/client-ui-session": "workspace:^",
    "@aeven/client-ui-sidebar": "workspace:^",
    "@aeven/client-ui-settings": "workspace:^",
    "@aeven/client-ui-slots": "workspace:^",
    "@aeven/client-ui-tool": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/tools": "workspace:^",
    "@aeven/util-crypto": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@aeven/client-ui-workspace": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
