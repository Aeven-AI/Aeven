// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > keeps the expanded contents mounted behind the closed sidebar, in place 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root"
  >
    <div
      class="content"
    >
      <button
        aria-label="Chat"
        class="brand"
        type="button"
      >
        <span
          aria-hidden="true"
          class="brandIdentity"
        >
          <span
            class="brandMark"
          >
            <div
              data-slot="sidebar.brand.mark"
              style="display: contents;"
            >
              <svg
                aria-hidden="true"
                data-content="a2c38529"
                fill="none"
                height="20.780923994038748"
                viewBox="0 0 671 581"
                width="24"
              />
            </div>
          </span>
          <span
            class="brandName"
          >
            <div
              data-slot="sidebar.brand.name"
              style="display: contents;"
            />
          </span>
        </span>
      </button>
      <div
        class="header"
      >
        <div
          class="headerLeading"
        >
          <div
            data-slot="sidebar.header.leading"
            style="display: contents;"
          />
        </div>
        <div
          class="headerActions"
        >
          <div
            data-slot="sidebar.header.action"
            style="display: contents;"
          />
        </div>
      </div>
      <div
        class="sideContent"
      >
        <div
          class="sideContentInner"
        >
          <a
            aria-label="Chat"
            class="newSession"
            href="/c/snapshot-1"
          >
            <svg
              aria-hidden="true"
              class="newSessionIcon"
              data-content="f9600f30"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.75"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            />
            <span
              class="newSessionLabel"
            >
              Chat
            </span>
          </a>
          <div
            data-slot="sidebar.nav"
            style="display: contents;"
          />
          <div
            aria-hidden="true"
            class="spacer"
          />
          <div
            class="regionArea"
          >
            <div
              data-slot="sidebar.workspaces"
              style="display: contents;"
            />
          </div>
          <div
            class="footArea"
          >
            <div
              class="footerActions"
            >
              <div
                data-slot="sidebar.footer.action"
                style="display: contents;"
              />
            </div>
            <div
              class="settingsArea"
            >
              <div
                data-slot="sidebar.settings"
                style="display: contents;"
              />
            </div>
          </div>
        </div>
      </div>
      <div
        aria-hidden="true"
        class="panel"
      />
    </div>
    <div
      class="contentBlocker"
      role="presentation"
    />
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders the expanded column (wordmark, capsule, empty holes) 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root visible"
  >
    <div
      class="content"
