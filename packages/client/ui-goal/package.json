{
  "name": "@aeven/client-ui-goal",
  "description": "Session goal surface: GoalBar docked above the composer, read from the goal session projection",
  "version": "0.3.6-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/client/ui-goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "avn": {
    "client": {
      "inject": [
        "@aeven/api-remotes",
        "@aeven/api-session-controller",
        "@aeven/client-locale",
        "@aeven/client-ui-chat",
        "@aeven/client-ui-conversation",
        "@aeven/client-ui-renderer",
        "@aeven/client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/api-remotes": "workspace:^",
    "@aeven/api-session-controller": "workspace:^",
    "@aeven/client-locale": "workspace:^",
    "@aeven/client-test-runtime": "workspace:^",
    "@aeven/client-ui-chat": "workspace:^",
    "@aeven/client-ui-conversation": "workspace:^",
    "@aeven/client-ui-primitives": "workspace:^",
    "@aeven/client-ui-slots": "workspace:^",
    "@aeven/client-ui-renderer": "workspace:^",
    "@aeven/client-ui-session": "workspace:^",
    "@aeven/commands": "workspace:^",
    "@aeven/goal": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@aeven/session": "workspace:^",
    "@aeven/typert-protocol": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
