{
  "name": "@aeven/client-ui-desktop-handoff",
  "description": "Desktop hand-off for the web version: what needs the reader's own computer opens the \"Available in Aeven Desktop\" dialog, which continues in the installed app or offers the download",
  "version": "0.3.45-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/client/ui-desktop-handoff"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "avn": {
    "client": {
      "inject": [
        "@aeven/api-remotes",
        "@aeven/api-session-controller",
        "@aeven/client-locale",
        "@aeven/client-ui-primitives",
        "@aeven/client-ui-layout",
        "@aeven/client-ui-sidebar-select",
        "@aeven/client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/api-remotes": "workspace:^",
    "@aeven/api-session-controller": "workspace:^",
    "@aeven/client-locale": "workspace:^",
    "@aeven/client-store": "workspace:^",
    "@aeven/client-ui-conversation": "workspace:^",
    "@aeven/client-ui-layout": "workspace:^",
    "@aeven/client-ui-primitives": "workspace:^",
    "@aeven/client-ui-renderer": "workspace:^",
    "@aeven/client-ui-sidebar-select": "workspace:^",
    "@aeven/client-ui-slots": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/tool-desktop-handoff": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
