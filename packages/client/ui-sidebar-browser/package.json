{
  "name": "@aeven/client-ui-sidebar-browser",
  "description": "Right sidebar browser: an Electron webview guest for HTTP(S) pages beside a session",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Harness.git",
    "directory": "packages/client/ui-sidebar-browser"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "avn": {
    "client": {
      "inject": [
        "@aeven/api-remotes",
        "@aeven/api-session-controller",
        "@aeven/client-ui-renderer",
        "@aeven/client-ui-sidebar-right",
        "@aeven/client-locale",
        "@aeven/client-ui-sidebar-select"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/client-locale": "workspace:^",
    "@aeven/client-test-runtime": "workspace:^",
    "@aeven/client-ui-primitives": "workspace:^",
    "@aeven/client-ui-renderer": "workspace:^",
    "@aeven/client-ui-session": "workspace:^",
    "@aeven/client-ui-sidebar-right": "workspace:^",
    "@aeven/client-ui-sidebar-select": "workspace:^",
    "@aeven/client-ui-slots": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@aeven/api-remotes": "workspace:^",
    "@aeven/api-session-controller": "workspace:^",
    "@aeven/tool-browser": "workspace:^",
    "@aeven/typert-protocol": "workspace:^",
    "@aeven/experimental-browser-overlay": "workspace:^",
    "@aeven/browser-chromium": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
