{
  "name": "@aeven/client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "0.3.21-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/client/ui-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "avn": {
    "client": {
      "inject": [
        "@aeven/api-session-controller",
        "@aeven/api-workspace-controller",
        "@aeven/client-locale",
        "@aeven/client-ui-conversation",
        "@aeven/client-ui-layout",
        "@aeven/client-ui-renderer",
        "@aeven/client-ui-session",
        "@aeven/client-ui-settings",
        "@aeven/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/agent": "workspace:^",
    "@aeven/api-remotes": "workspace:^",
    "@aeven/api-session-controller": "workspace:^",
    "@aeven/api-workspace-controller": "workspace:^",
    "@aeven/attachment": "workspace:^",
    "@aeven/client-locale": "workspace:^",
    "@aeven/client-store": "workspace:^",
    "@aeven/client-ui-approval": "workspace:^",
    "@aeven/client-ui-conversation": "workspace:^",
    "@aeven/client-ui-layout": "workspace:^",
    "@aeven/client-ui-primitives": "workspace:^",
    "@aeven/client-ui-renderer": "workspace:^",
    "@aeven/client-ui-session": "workspace:^",
    "@aeven/client-ui-settings": "workspace:^",
    "@aeven/client-ui-slots": "workspace:^",
    "@aeven/client-ui-workspace": "workspace:^",
    "@aeven/commands": "workspace:^",
    "@aeven/compaction": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/llm-retry": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-turn-outline": "workspace:^",
    "@aeven/session-stats": "workspace:^",
    "@aeven/token-meter": "workspace:^",
    "@aeven/tools": "workspace:^",
    "@aeven/util-workspace-path": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@aeven/settings": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
