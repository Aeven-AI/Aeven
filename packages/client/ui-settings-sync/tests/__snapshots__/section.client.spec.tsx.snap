exports[`Sync settings > 'zh' keeps catch-up distinct from completed synchronization > downloading 1`] = `"同步你的对话、记忆和设置在你登录的每台设备上保持一致。它们在离开这台设备之前就已加密。同步这台设备关闭后，这台设备的内容只留在本机。已有的内容会保留在这里。正在同步…正在下载更改…设备Laptop"`;

exports[`Sync settings > 'zh' keeps catch-up distinct from completed synchronization > up-to-date 1`] = `"同步你的对话、记忆和设置在你登录的每台设备上保持一致。它们在离开这台设备之前就已加密。同步这台设备关闭后，这台设备的内容只留在本机。已有的内容会保留在这里。已是最新100%设备Laptop"`;
