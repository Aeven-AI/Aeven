{
  "name": "@aeven/api-memory-manager",
  "description": "Signed-in user's view of what Aeven has learned: memories and learned capabilities, over a Remote",
  "version": "0.3.8-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/memory/api-memory-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/capability": "workspace:^",
    "@aeven/identity-user": "workspace:^",
    "@aeven/memory": "workspace:^",
    "@aeven/memory-invariants": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-query": "workspace:^",
    "@aeven/typert-protocol": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/capability": "workspace:^",
    "@aeven/identity-user": "workspace:^",
    "@aeven/memory": "workspace:^",
    "@aeven/memory-invariants": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-query": "workspace:^",
    "@aeven/typert-protocol": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  }
}
