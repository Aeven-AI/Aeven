{
  "name": "@aeven/goal-round-driver",
  "description": "Race-fenced same-session goal-round driver",
  "version": "0.3.12-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/goal/goal-round-driver"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/goal": "workspace:^",
    "@aeven/invariants": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/agent-loop": "workspace:^",
    "@aeven/agent-loop-testkit": "workspace:^",
    "@aeven/goal": "workspace:^",
    "@aeven/invariants": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/system-prompt": "workspace:^",
    "@aeven/tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/session-projection": "workspace:^"
  }
}
