{
  "name": "@aeven/client-ui-cordis",
  "description": "Cordis dynamic-plugin definition card: the keyed cordis_define tool row with its run/stop switch",
  "version": "0.3.30-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/extensions/ui-cordis"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "avn": {
    "client": {
      "inject": [
        "@aeven/client-connection",
        "@aeven/cordis-client-runner",
        "@aeven/api-remotes",
        "@aeven/client-locale",
        "@aeven/client-ui-input-trigger",
        "@aeven/client-ui-renderer",
        "@aeven/client-ui-session",
        "@aeven/client-ui-tool",
        "@aeven/client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/api-remotes": "workspace:^",
    "@aeven/client-connection": "workspace:^",
    "@aeven/cordis-client-runner": "workspace:^",
    "@aeven/client-locale": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/client-ui-primitives": "workspace:^",
    "@aeven/client-ui-sidebar": "workspace:^",
    "@aeven/client-ui-input-trigger": "workspace:^",
    "@aeven/client-ui-renderer": "workspace:^",
    "@aeven/client-ui-session": "workspace:^",
    "@aeven/client-ui-slots": "workspace:^",
    "@aeven/client-ui-tool": "workspace:^",
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
