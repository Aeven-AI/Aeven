{
  "name": "@aeven/device",
  "description": "iOS Simulator and Android Emulator seam: device hosts, per-session device sessions, the device pane's state stream, and the authenticated hub proxy",
  "version": "0.3.18-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/device/device"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@aeven/home-paths": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@aeven/identity-user": "workspace:^",
    "@aeven/typert-protocol": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/brand": "workspace:^",
    "@aeven/client-connection": "workspace:^",
    "@aeven/host-webserver": "workspace:^",
    "@aeven/identity-user": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/settings": "workspace:^",
    "@aeven/typert-protocol": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
