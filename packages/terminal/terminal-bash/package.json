{
  "name": "@aeven/terminal-bash",
  "description": "Persistent shell PTY backend over the Aeven subprocess terminal primitive",
  "version": "0.3.16-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/terminal": "workspace:^",
    "@aeven/sandbox": "workspace:^",
    "@aeven/sandbox-policy": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/subprocess": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/session-projection": "workspace:^"
  },
  "dependencies": {
    "@aeven/pwsh-local": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/terminal": "workspace:^",
    "@aeven/sandbox": "workspace:^",
    "@aeven/sandbox-policy": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/subprocess": "workspace:^",
    "@aeven/subprocess-local": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
