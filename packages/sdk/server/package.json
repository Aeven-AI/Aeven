{
  "name": "@aeven/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Aeven SDK clients",
  "version": "0.3.26-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@aeven/brand": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/agent": "workspace:^",
    "@aeven/attachment": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/llm-deepseek": "workspace:^",
    "@aeven/scope": "workspace:^",
    "@aeven/sdk-protocol": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/subagent": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@aeven/agent": "workspace:^",
    "@aeven/agent-loop": "workspace:^",
    "@aeven/agent-loop-testkit": "workspace:^",
    "@aeven/attachment": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/llm-deepseek": "workspace:^",
    "@aeven/scope": "workspace:^",
    "@aeven/sdk-protocol": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-persistence-jsonl": "workspace:^",
    "@aeven/session-projection": "workspace:^",
    "@aeven/subagent": "workspace:^"
  }
}
