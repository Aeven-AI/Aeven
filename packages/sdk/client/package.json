{
  "name": "@aeven/sdk-client",
  "description": "TypeScript client SDK for driving an Aeven runtime subprocess over stdio JSON-RPC: the Aeven high-level turns API and the lower-level HarnessClient",
  "version": "0.3.30-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@aeven/cli": "workspace:*"
  },
  "peerDependencies": {
    "@aeven/llm": "workspace:^",
    "@aeven/sdk-protocol": "workspace:^",
    "@aeven/session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/llm": "workspace:^",
    "@aeven/sdk-protocol": "workspace:^",
    "@aeven/session": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
