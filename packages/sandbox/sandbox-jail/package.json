{
  "name": "@aeven/sandbox-jail",
  "description": "Per-account process jail for a Linux Host that runs the commands of many accounts: bubblewrap namespaces without network, the Landlock launcher, and per-account cgroups, behind the Aeven sandbox seam",
  "version": "0.3.37-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/sandbox/sandbox-jail"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/attachment": "workspace:^",
    "@aeven/sandbox": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/system-prompt": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/node-addon-landlock-run": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@aeven/attachment": "workspace:^",
    "@aeven/sandbox": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/system-prompt": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
