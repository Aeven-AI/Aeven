{
  "name": "@aeven/api-terminal-controller",
  "description": "Interactive browser terminals over Typert Remote",
  "version": "0.3.19-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/api/terminal-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "avn": {
    "client": {
      "inject": [
        "@aeven/api-gateway"
      ],
      "external": [
        "@aeven/api-gateway/client"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@aeven/deque": "workspace:^",
    "@aeven/tools": "workspace:^",
    "@aeven/typert-protocol": "workspace:^",
    "@aeven/util-values": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/scope": "workspace:^"
  },
  "devDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/api-gateway": "workspace:^",
    "@aeven/brand": "workspace:^",
    "@aeven/client-store": "workspace:^",
    "@aeven/identity-user": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/sandbox-policy": "workspace:^",
    "@aeven/scope": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-projection": "workspace:^",
    "@aeven/subprocess": "workspace:^",
    "@aeven/subprocess-local": "workspace:^",
    "@aeven/system-prompt": "workspace:^",
    "@aeven/typert-registry": "workspace:^",
    "@aeven/user-approval": "workspace:^",
    "@aeven/util-crypto": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@aeven/working-directory": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}
