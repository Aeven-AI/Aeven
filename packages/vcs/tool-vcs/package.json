{
  "name": "@aeven/tool-vcs",
  "description": "Model-facing source-control tools for Aeven (git_status, git_diff, git_log, git_commit, git_branch, git_remote, git_merge) over the ctx.vcs capability seam",
  "version": "0.3.28-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/vcs/tool-vcs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/tools": "workspace:^",
    "@aeven/vcs": "workspace:^",
    "@aeven/working-directory": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/tools": "workspace:^",
    "@aeven/vcs": "workspace:^",
    "@aeven/working-directory": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
