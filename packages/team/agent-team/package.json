{
  "name": "@aeven/agent-team",
  "description": "Shared task board for subagent trees: owners, dependencies, compare-and-set claims, and write-scope warnings",
  "version": "0.3.41-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/team/agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@aeven/brand": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/agent": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-projection": "workspace:^",
    "@aeven/subagent": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/agent": "workspace:^",
    "@aeven/agent-loop": "workspace:^",
    "@aeven/agent-loop-testkit": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-persistence-jsonl": "workspace:^",
    "@aeven/session-projection": "workspace:^",
    "@aeven/session-query": "workspace:^",
    "@aeven/subagent": "workspace:^",
    "@aeven/subagent-fork-in-process": "workspace:^",
    "@aeven/subagent-spawn-in-process": "workspace:^"
  }
}
