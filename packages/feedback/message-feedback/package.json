{
  "name": "@aeven/message-feedback",
  "description": "Lifecycle-bound per-message rating and note sidecar for the Aeven",
  "version": "0.3.23-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/feedback/message-feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/brand": "workspace:^",
    "@aeven/identity-user": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-persistence": "workspace:^",
    "@aeven/storage-domain": "workspace:^",
    "@aeven/typert-protocol": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/sync": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3",
    "yjs": "13.6.27"
  },
  "devDependencies": {
    "@aeven/brand": "workspace:^",
    "@aeven/identity-user": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-persistence": "workspace:^",
    "@aeven/session-persistence-jsonl": "workspace:^",
    "@aeven/storage": "workspace:^",
    "@aeven/storage-domain": "workspace:^",
    "@aeven/storage-json": "workspace:^",
    "@aeven/typert-protocol": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@aeven/sync": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@aeven/sync": {
      "optional": true
    }
  }
}
