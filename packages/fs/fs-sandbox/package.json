{
  "name": "@aeven/fs-sandbox",
  "description": "Sandbox-enforcing implementation of the Aeven filesystem seam: fences write/edit by the per-call sandbox mode (read-only denies mutation, workspace-write contains it to the workspace + temp roots) while reads pass through",
  "version": "0.3.23-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/fs/fs-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/fs": "workspace:^",
    "@aeven/fs-local": "workspace:^",
    "@aeven/sandbox": "workspace:^",
    "@aeven/sandbox-policy": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/fs": "workspace:^",
    "@aeven/fs-local": "workspace:^",
    "@aeven/sandbox": "workspace:^",
    "@aeven/sandbox-policy": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/session-projection": "workspace:^"
  }
}
