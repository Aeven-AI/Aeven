  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/fs": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "koffi": "^3.1.0",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@aeven/fs": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
