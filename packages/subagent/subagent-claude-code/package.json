    "@aeven/subprocess": "workspace:^",
    "@aeven/timeout": "workspace:^"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.241",
    "@anthropic-ai/sdk": "0.115.0",
    "@aeven/brand": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/agent": "workspace:^",
    "@aeven/app-boot": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/loader-smoke": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-checkpoint-policy": "workspace:^",
