    "@aeven/app-boot": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/loader-smoke": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-checkpoint-policy": "workspace:^",
