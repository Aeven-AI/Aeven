    "@aeven/llm": "workspace:^",
    "@aeven/mcp-client": "workspace:^",
    "@aeven/scope": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/system-prompt": "workspace:^",
    "@aeven/tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/code-runtime": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/mcp-client": "workspace:^",
    "@aeven/scope": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/system-prompt": "workspace:^",
    "@aeven/tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^"
  }
}
