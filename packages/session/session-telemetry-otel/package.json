{
  "name": "@aeven/session-telemetry-otel",
  "description": "OpenTelemetry backend for the Aeven telemetry seam: hands captured session records to the OTel JS SDK's log pipeline",
  "version": "0.3.14-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/session/session-telemetry-otel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-exporter-base": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@aeven/command-feedback": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-telemetry": "workspace:^",
    "@aeven/anonymous-user-id": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-logger-console": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@aeven/app-boot": "workspace:^",
    "@aeven/bash-local": "workspace:^",
    "@aeven/command-feedback": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/loader-smoke": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-checkpoint-policy": "workspace:^",
    "@aeven/session-persistence-jsonl": "workspace:^",
    "@aeven/session-telemetry": "workspace:^",
    "@aeven/subprocess-local": "workspace:^",
    "@aeven/anonymous-user-id": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/http-proxy": "workspace:^"
  }
}
