{
  "name": "@aeven/session-projection-cache",
  "description": "Persisted projection cache (ctx.sessionProjectionCache): durable per-session checkpoint records on the session_projcache storage domain (per-record layout), throttled write-behind, and the cached listing read",
  "version": "0.3.4-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/session/session-projection-cache"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@aeven/util-values": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-projection": "workspace:^",
    "@aeven/storage-domain": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-projection": "workspace:^",
    "@aeven/storage": "workspace:^",
    "@aeven/storage-domain": "workspace:^",
    "@aeven/storage-json": "workspace:^"
  }
}
