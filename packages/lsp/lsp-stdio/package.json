{
  "name": "@aeven/lsp-stdio",
  "description": "Generic stdio language-server provider for the Aeven LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.3.17-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/brand": "workspace:^",
    "@aeven/fs": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/lsp": "workspace:^",
    "@aeven/subprocess": "workspace:^",
    "@aeven/timeout": "workspace:^"
  },
  "dependencies": {
    "@aeven/util-values": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/brand": "workspace:^",
    "@aeven/fs": "workspace:^",
    "@aeven/fs-local": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/lsp": "workspace:^",
    "@aeven/subprocess": "workspace:^",
    "@aeven/subprocess-local": "workspace:^",
    "@aeven/timeout": "workspace:^",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}
