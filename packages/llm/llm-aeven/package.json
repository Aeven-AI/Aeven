    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@aeven/agent": "workspace:^",
    "@aeven/anonymous-user-id": "workspace:^",
    "@aeven/credentials": "workspace:^",
    "@aeven/identity-user": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/llm-deepseek": "workspace:^",
    "@aeven/settings": "workspace:^",
    "@aeven/timeout": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
