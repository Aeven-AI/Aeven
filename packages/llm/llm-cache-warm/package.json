{
  "name": "@aeven/llm-cache-warm",
  "description": "Prompt-cache warmer plugin: while a tool call keeps the loop waiting, replay the session's last conversation request with a one-token cap so the next step lands on a cached prefix",
  "version": "0.3.23-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/llm/llm-cache-warm"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@aeven/llm": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/timeout": "workspace:^",
    "@aeven/tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@aeven/llm": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/timeout": "workspace:^",
    "@aeven/tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
