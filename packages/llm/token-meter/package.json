    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/compaction": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/llm-cache-warm": "workspace:^",
    "@aeven/llm-retry": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-projection": "workspace:^"
  },
  "dependencies": {
    "@aeven/util-values": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/compaction": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/llm-cache-warm": "workspace:^",
    "@aeven/llm-retry": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-projection": "workspace:^"
  }
}
