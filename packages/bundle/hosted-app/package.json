{
  "name": "@aeven/hosted-app",
  "description": "The avn hosted bundle: the web patch layer narrowed for a Host that Aeven operates for many accounts, which runs no command or file operation on its own machine and keeps no setting one account could change for another",
  "version": "0.3.41-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/bundle/hosted-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "avn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@aeven/api-motion": "workspace:^",
    "@aeven/client-ui-desktop-handoff": "workspace:^",
    "@aeven/client-ui-workspace-name": "workspace:^",
    "@aeven/motion": "workspace:^",
    "@aeven/motion-sandbox": "workspace:^",
    "@aeven/sandbox-jail": "workspace:^",
    "@aeven/speech-to-text-aeven": "workspace:^",
    "@aeven/subprocess-executor": "workspace:^",
    "@aeven/web-app": "workspace:^",
    "@deepseek-ai/cordis-plugin-logger-console": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/agent": "workspace:^",
    "@aeven/identity-user": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/attachment": "workspace:^",
    "@aeven/session-handoff": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@aeven/host-webserver": "workspace:^",
    "@aeven/agent": "workspace:^",
    "@aeven/identity-user": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/attachment": "workspace:^",
    "@aeven/session-handoff": "workspace:^"
  }
}
