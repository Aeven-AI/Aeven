{
  "name": "@aeven/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, editor, and JSONL sessions",
  "version": "0.3.5-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "avn": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "workspace:^",
    "@aeven/agent": "workspace:^",
    "@aeven/agent-loop": "workspace:^",
    "@aeven/deepseek-llm-api-extensions": "workspace:^",
    "@aeven/fs-local": "workspace:^",
    "@aeven/invariants": "workspace:^",
    "@aeven/jobs-local": "workspace:^",
    "@aeven/llm": "workspace:^",
    "@aeven/llm-deepseek": "workspace:^",
    "@aeven/llm-retry": "workspace:^",
    "@aeven/plugin-package-inventory-deepseek": "workspace:^",
    "@aeven/sandbox-local": "workspace:^",
    "@aeven/sandbox-policy": "workspace:^",
    "@aeven/scope": "workspace:^",
    "@aeven/sdk-app": "workspace:^",
    "@aeven/sdk-jsonrpc-server": "workspace:^",
    "@aeven/session": "workspace:^",
    "@aeven/session-log-deepseek": "workspace:^",
    "@aeven/session-persistence-jsonl": "workspace:^",
    "@aeven/session-projection": "workspace:^",
    "@aeven/session-title": "workspace:^",
    "@aeven/subprocess-local": "workspace:^",
    "@aeven/system-prompt": "workspace:^",
    "@aeven/terminal": "workspace:^",
    "@aeven/terminal-bash": "workspace:^",
    "@aeven/tool-bash-persistent": "workspace:^",
    "@aeven/tool-pwsh-persistent": "workspace:^",
    "@aeven/tool-str-replace-editor": "workspace:^",
    "@aeven/tools": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
