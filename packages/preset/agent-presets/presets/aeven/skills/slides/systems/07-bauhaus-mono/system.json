{
  "id": "bauhaus-mono",
  "name": "Bauhaus Mono",
  "label": "Bauhaus Mono",
  "preset": "minimal",
  "motif": "16 × 9 grid of 80px modules; circle, square, quarter circle, half disc and bars as structure",
  "paper": {
    "light": "#F3F1EC",
    "dark": "#111111"
  },
  "ink": {
    "black": "#111111",
    "grey1": "#DADADA",
    "grey2": "#A3A3A3",
    "grey3": "#5E5E5E",
    "white": "#FFFFFF",
    "rule": "rgba(17,17,17,.22)"
  },
  "grid": {
    "module": 80,
    "columns": 16,
    "rows": 9
  },
  "type": {
    "family": "geometric sans",
    "fonts": {
      "text": "Jost",
      "display": "Jost"
    }
  },
  "palette": {
    "paper": "#F3F1EC",
    "ink": "#111111",
    "muted": "#5E5E5E",
    "rule": "rgba(17,17,17,.22)",
    "onAccent": "#FFFFFF",
    "accents": [
      "#111111",
      "#5E5E5E",
      "#A3A3A3",
      "#DADADA"
    ]
  }
}
