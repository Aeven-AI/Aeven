{
  "name": "@aeven/subprocess-executor",
  "description": "Subprocess runtime that starts commands without forking the Host: a small helper keeps idle launchers that exec each command, keeping the local runtime's process ownership, stdio collection, and tree signalling",
  "version": "0.3.42-alpha",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeven-AI/Aeven.git",
    "directory": "packages/subprocess/subprocess-executor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.cjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@aeven/subprocess": "workspace:^",
    "@aeven/subprocess-local": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@aeven/subprocess": "workspace:^",
    "@aeven/subprocess-local": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
